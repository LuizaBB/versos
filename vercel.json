{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend",
      "framework": "fastapi",
      "memory": 1024,
      "excludeFiles": [
        "alembic/**",
        "alembic.ini",
        "scripts/**",
        "**/__pycache__/**",
        "**/*.pyc"
      ]
    }
  }
}
